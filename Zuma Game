import collections

class Solution(object):
    def findMinStep(self, board, hand):
        def clean(s):
            i = 0
            while i < len(s):
                j = i
                while j < len(s) and s[j] == s[i]:
                    j += 1
                if j - i >= 3:
                    return clean(s[:i] + s[j:])
                i = j
            return s

        hand_counts = collections.Counter(hand)
        memo = {}

        def dfs(curr_board, curr_hand):
            curr_hand_tuple = tuple(sorted(curr_hand.items()))
            state = (curr_board, curr_hand_tuple)
            
            if not curr_board:
                return 0
            if state in memo:
                return memo[state]
            
            res = float('inf')
            
            # Board-la irukkara ovvoru unique position-layum balls insert panni paakrom
            for i in range(len(curr_board) + 1):
                for color in curr_hand:
                    if curr_hand[color] > 0:
                        # Optimization: Same color pakkathu pakkathu la irundha mattum try pannuvom
                        # Illana board-la illadha color-a use panna maattom
                        new_board = clean(curr_board[:i] + color + curr_board[i:])
                        curr_hand[color] -= 1
                        
                        steps = dfs(new_board, curr_hand)
                        if steps != -1:
                            res = min(res, 1 + steps)
                            
                        curr_hand[color] += 1
            
            memo[state] = res if res != float('inf') else -1
            return memo[state]

        return dfs(board, hand_counts)
