class Solution(object):
    def strongPasswordChecker(self, password):
        n = len(password)
        has_lower = any(c.islower() for c in password)
        has_upper = any(c.isupper() for c in password)
        has_digit = any(c.isdigit() for c in password)
        
        missing_types = (1 if not has_lower else 0) + \
                        (1 if not has_upper else 0) + \
                        (1 if not has_digit else 0)
        
        replace_count = 0
        one_rem = 0
        two_rem = 0
        
        i = 2
        while i < n:
            if password[i] == password[i-1] == password[i-2]:
                length = 2
                while i < n and password[i] == password[i-1]:
                    length += 1
                    i += 1
                
                replace_count += length // 3
                if length % 3 == 0: one_rem += 1
                elif length % 3 == 1: two_rem += 2
            else:
                i += 1
        
        if n < 6:
            return max(missing_types, 6 - n)
        
        elif n <= 20:
            return max(missing_types, replace_count)
        
        else:
            delete_count = n - 20
            
            replace_count -= min(delete_count, one_rem)
            replace_count -= min(max(delete_count - one_rem, 0), two_rem) // 2
            replace_count -= max(delete_count - one_rem - two_rem, 0) // 3
            
            return delete_count + max(missing_types, replace_count)
