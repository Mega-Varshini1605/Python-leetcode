class Solution(object):
    def isRectangleCover(self, rectangles):
        area = 0
        min_x, min_y = float('inf'), float('inf')
        max_a, max_b = float('-inf'), float('-inf')
        corners = set()

        for x, y, a, b in rectangles:
            min_x, min_y = min(min_x, x), min(min_y, y)
            max_a, max_b = max(max_a, a), max(max_b, b)
            
            area += (a - x) * (b - y)
            
            for point in [(x, y), (x, b), (a, y), (a, b)]:
                if point in corners:
                    corners.remove(point)
                else:
                    corners.add(point)

        expected_corners = {(min_x, min_y), (min_x, max_b), (max_a, min_y), (max_a, max_b)}
        
        if corners != expected_corners:
            return False

        return area == (max_a - min_x) * (max_b - min_y)
