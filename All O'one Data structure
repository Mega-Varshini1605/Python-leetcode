class Node:
    def __init__(self, count):
        self.count = count
        self.keys = set()
        self.prev = None
        self.next = None

class AllOne(object):
    def __init__(self):
        self.nodes = {}  # key -> node
        self.head = Node(0)  # Dummy head
        self.tail = Node(0)  # Dummy tail
        self.head.next = self.tail
        self.tail.prev = self.head

    def _add_node_after(self, new_node, prev_node):
        new_node.prev = prev_node
        new_node.next = prev_node.next
        prev_node.next.prev = new_node
        prev_node.next = new_node

    def _remove_node(self, node):
        node.prev.next = node.next
        node.next.prev = node.prev

    def inc(self, key):
        if key not in self.nodes:
            if self.head.next.count != 1:
                self._add_node_after(Node(1), self.head)
            self.head.next.keys.add(key)
            self.nodes[key] = self.head.next
        else:
            curr_node = self.nodes[key]
            if curr_node.next.count != curr_node.count + 1:
                self._add_node_after(Node(curr_node.count + 1), curr_node)
            curr_node.next.keys.add(key)
            self.nodes[key] = curr_node.next
            curr_node.keys.remove(key)
            if not curr_node.keys:
                self._remove_node(curr_node)

    def dec(self, key):
        curr_node = self.nodes[key]
        if curr_node.count == 1:
            del self.nodes[key]
        else:
            if curr_node.prev.count != curr_node.count - 1:
                self._add_node_after(Node(curr_node.count - 1), curr_node.prev)
            curr_node.prev.keys.add(key)
            self.nodes[key] = curr_node.prev
        
        curr_node.keys.remove(key)
        if not curr_node.keys:
            self._remove_node(curr_node)

    def getMaxKey(self):
        if self.tail.prev == self.head:
            return ""
        return next(iter(self.tail.prev.keys))

    def getMinKey(self):
        if self.head.next == self.tail:
            return ""
        return next(iter(self.head.next.keys))
