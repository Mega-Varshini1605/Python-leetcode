class Solution(object):
    def largestPalindrome(self, n):
        if n == 1: return 9
        
        upper = 10**n - 1
        lower = 10**(n-1)
        
        for left in range(upper, lower - 1, -1):
            p = int(str(left) + str(left)[::-1])
            
            j = upper
            while j * j >= p:
                if p % j == 0:
                    return p % 1337
                j -= 1
        
        return -1
