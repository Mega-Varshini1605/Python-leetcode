from collections import defaultdict, OrderedDict

class LFUCache(object):
    def __init__(self, capacity):
        self.capacity = capacity
        self.min_freq = 0
        self.key_map = {}  # key -> [value, freq]
        self.freq_map = defaultdict(OrderedDict) # freq -> {key: None}

    def _update(self, key):
        val, freq = self.key_map[key]
        self.freq_map[freq].pop(key)
        
        if not self.freq_map[freq] and freq == self.min_freq:
            self.min_freq += 1
            
        self.key_map[key][1] = freq + 1
        self.freq_map[freq + 1][key] = None

    def get(self, key):
        if key not in self.key_map:
            return -1
        self._update(key)
        return self.key_map[key][0]

    def put(self, key, value):
        if self.capacity <= 0:
            return
        
        if key in self.key_map:
            self.key_map[key][0] = value
            self._update(key)
        else:
            if len(self.key_map) >= self.capacity:
                # LFU and LRU (first item in OrderedDict)
                k, _ = self.freq_map[self.min_freq].popitem(last=False)
                del self.key_map[k]
                
            self.key_map[key] = [value, 1]
            self.freq_map[1][key] = None
            self.min_freq = 1
